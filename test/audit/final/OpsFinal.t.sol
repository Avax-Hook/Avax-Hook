/// Heavy 8-module launch (every one of them with storage-touching swap/transfer callbacks): does any buy, sell
/// or transfer revert or silently drop a module (ModuleFailed) because of gas?
/// forge-config: default.isolate = true
contract OpsHeavyComboFinal is ListsAccessBase {
    AlliancesModule al;
    PlagueModule pl;
    ConvictionCapModule cc;
    GraduatedSellCapModule gs;
    LockEarnModule le;
    GrudgeModule gr;
    JackpotModule jp;
    UnderwaterModule uw;
    uint32[] ids;
    bytes[] cfgs;
    HookTokenV2 t;
    PoolKey key;
    address keeper = makeAddr("keeper");
    bytes32 constant FAILED = keccak256("ModuleFailed(bytes32,address,bytes4)");

    function setUp() public override {
        super.setUp();
        al = new AlliancesModule(address(hook));
        pl = new PlagueModule(address(hook));
        cc = new ConvictionCapModule(address(hook));
        gs = new GraduatedSellCapModule(address(hook));
        le = new LockEarnModule(address(hook));
        gr = new GrudgeModule(address(hook));
        jp = new JackpotModule(address(hook));
        uw = new UnderwaterModule(address(hook), SAFE);
        vm.prank(SAFE);
        uw.setKeeper(keeper);
        address[] memory allies = new address[](4);
        address[] memory rivals = new address[](4);
        for (uint256 i; i < 4; ++i) {
            allies[i] = address(new MockRewardToken());
            rivals[i] = address(new MockRewardToken());
            _allowQuote(allies[i]);
            _allowQuote(rivals[i]);
        }
        ids.push(modules.addModule(address(al), "{}"));
        ids.push(modules.addModule(address(pl), "{}"));
        ids.push(modules.addModule(address(cc), "{}"));
        ids.push(modules.addModule(address(gs), "{}"));
        ids.push(modules.addModule(address(le), "{}"));
        ids.push(modules.addModule(address(gr), "{}"));
        ids.push(modules.addModule(address(jp), "{}"));
        ids.push(modules.addModule(address(uw), "{}"));
        cfgs.push(abi.encode(AlliancesModule.Config(5_000, 1 ether, 1 ether, allies, rivals)));
        cfgs.push(abi.encode(PlagueModule.Config(1_000 ether, 0)));
        cfgs.push(abi.encode(ConvictionCapModule.Config(1_000, 100, 1 days, 5_000, 0)));
        cfgs.push(abi.encode(GraduatedSellCapModule.Config(100, 100, 1_000, 50, 0)));
        cfgs.push(abi.encode(LockEarnModule.Config(100, 1 hours)));
        cfgs.push(abi.encode(GrudgeModule.Config(1_000, 1 hours, 30 days, 1, 500, 0)));
        cfgs.push(abi.encode(JackpotModule.Config(100, 10 minutes, 0.5 ether, 1)));
        cfgs.push(abi.encode(UnderwaterModule.Config(100, 0, 5 minutes, 10_000, 2_500)));
        t = _launch(ids, cfgs, 100);
        key = _graduateCapped(t, 9_000_000 ether, 30);
    }

    function _failures() internal returns (uint256 n) {
        Vm.Log[] memory logs = vm.getRecordedLogs();
        for (uint256 i; i < logs.length; ++i) {
            if (logs[i].emitter == address(hook) && logs[i].topics[0] == FAILED) {
                ++n;
                console2.log("ModuleFailed", address(uint160(uint256(logs[i].topics[2]))));
            }
        }
    }

    function test_heavyComboGas() public {
        uint256 maxBuy;
        uint256 maxSell;
        uint256 maxXfer;
        vm.recordLogs();
        for (uint256 r; r < 30; ++r) {
            // a day passes (LockEarn folds daily batches, Jackpot rounds close, ConvictionCap grows)
            vm.warp(vm.getBlockTimestamp() + 1 days + 7 minutes);
            vm.roll(block.number + 50);
            address w = _holder(r);
            address w2 = _holder(r + 1);
            // lock part of the bag, each with a different unlock day
            uint256 bal = t.balanceOf(w);
            if (bal > 0) {
                vm.prank(w);
                le.lock(address(t), bal / 10, vm.getBlockTimestamp() + (r % 9 + 1) * 1 days);
            }
            uint256 g = gasleft();
            vm.deal(w, w.balance + 5 ether);
            _routerBuy(w, t, 2 ether);
            uint256 used = g - gasleft();
            if (used > maxBuy) maxBuy = used;
            // sell ~half of the unlocked part, under the per-sell cap (dump -> grudge)
            uint256 sellAmt = t.balanceOf(w) / 3;
            if (sellAmt > 4_000_000 ether) sellAmt = 4_000_000 ether;
            g = gasleft();
            _routerSell(w, t, sellAmt);
            used = g - gasleft();
            if (used > maxSell) maxSell = used;
            // wallet-to-wallet (infects, checks rivals/allies, caps, locks)
            g = gasleft();
            _send(t, w, w2, 1_000 ether);
            used = g - gasleft();
            if (used > maxXfer) maxXfer = used;
            // keepers
            try jp.settle(address(t)) {} catch {}
            address[] memory l = new address[](2);
            (l[0], l[1]) = (w, w2);
            vm.prank(keeper);
            try uw.distribute(address(t), l) {} catch {}
        }
        console2.log("max router buy gas", maxBuy);
        console2.log("max router sell gas", maxSell);
        console2.log("max transfer gas", maxXfer);
        assertEq(_failures(), 0, "a module failed (gas?) on the sell path");
    }

    /// After a long idle stretch (many LockEarn unlock days, Jackpot round left unsettled for > 256 blocks).
    function test_heavyComboAfterIdle() public {
        for (uint256 r; r < 12; ++r) {
            address w = _holder(r);
            uint256 bal = t.balanceOf(w);
            vm.prank(w);
            le.lock(address(t), bal / 10, vm.getBlockTimestamp() + (r + 1) * 1 days);
        }
        vm.warp(vm.getBlockTimestamp() + 40 days);
        vm.roll(block.number + 100_000);
        vm.recordLogs();
        address w0 = _holder(0);
        uint256 g = gasleft();
        _routerSell(w0, t, 1_000_000 ether);
        console2.log("sell after idle gas", g - gasleft());
        g = gasleft();
        _routerBuy(w0, t, 2 ether);
        console2.log("buy after idle gas", g - gasleft());
        assertEq(_failures(), 0, "module failed after idle");
    }
}


